# 复制本文件为 .env 并填入你自己的 Supabase 项目信息
# Copy this file to .env and fill in your own Supabase project credentials
#
# 在 Supabase Dashboard → Project Settings → API 中找到这两个值
# Find these values at Supabase Dashboard → Project Settings → API
#
# 注意：只填 anon / publishable key，千万不要提交 service_role key！
# Note: only use the anon / publishable key. NEVER commit the service_role key!

# 项目地址，形如 https://xxxxxxxx.supabase.co
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# anon 公开密钥（安全可公开，数据安全由 RLS 策略保证）
VITE_SUPABASE_ANON_KEY=your-anon-publishable-key
